  "keyFeatures": [
    "Upload and organize UI screenshots and wireframes with rich metadata",
    "Automatic design analysis: color palettes, layout detection, UI components",
    "Tag and category system for flexible library organization",
    "Full-text and tag-based search and filtering",
    "Built-in MCP (Model Context Protocol) server for AI agent access",
    "API key management for secure agent authentication",
    "JSON export of your entire design library",
    "Native macOS menubar integration",
    "Local-only storage for privacy (no cloud sync)"
  ],
  "publicApiSurface": [
    "GET /health",
    "POST /mcp/list-screenshots",
    "POST /mcp/get-screenshot-metadata",
    "POST /mcp/get-design-specifications"
